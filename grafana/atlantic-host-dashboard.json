{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Bots Online",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "expr": "hosting_bots_online", "legendFormat": "online", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Bots Total",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        { "expr": "hosting_bots_total", "legendFormat": "total", "refId": "A" }
      ]
    },
    {
      "title": "Pedidos Abertos",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        { "expr": "hosting_orders_open", "legendFormat": "orders", "refId": "A" }
      ]
    },
    {
      "title": "Fila (pending)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        { "expr": "hosting_queue_size", "legendFormat": "queued", "refId": "A" }
      ]
    },
    {
      "title": "Panel Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        { "expr": "hosting_panel_uptime_seconds", "legendFormat": "uptime", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Host Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "hosting_host_memory_total_bytes - hosting_host_memory_free_bytes", "legendFormat": "used", "refId": "A" },
        { "expr": "hosting_host_memory_free_bytes", "legendFormat": "free", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "title": "Panel Memory (RSS / Heap)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "hosting_panel_memory_rss_bytes", "legendFormat": "rss", "refId": "A" },
        { "expr": "hosting_panel_memory_heap_bytes", "legendFormat": "heap", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "title": "Load Average (1m)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "hosting_host_load1", "legendFormat": "load1", "refId": "A" }
      ]
    },
    {
      "title": "Queue processed / failed",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "rate(hosting_queue_processed_total[5m])", "legendFormat": "processed/s", "refId": "A" },
        { "expr": "rate(hosting_queue_failed_total[5m])", "legendFormat": "failed/s", "refId": "B" }
      ]
    },
    {
      "title": "Bots Online vs Total",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 19 },
      "targets": [
        { "expr": "hosting_bots_online", "legendFormat": "online", "refId": "A" },
        { "expr": "hosting_bots_total", "legendFormat": "total", "refId": "B" },
        { "expr": "hosting_bots_suspended", "legendFormat": "suspended", "refId": "C" }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["atlantic-host", "discord"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Atlantic Host Overview",
  "uid": "atlantic-host-overview",
  "version": 1
}
