# Copy this file to .env in the same directory and fill in real values.
# NEVER commit the real .env file (it is already in .gitignore).

NODE_ENV=development
PORT=4000

# Secrets -- generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=
NODE_AGENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Optional: seeds one admin user on first boot if both are set
ADMIN_EMAIL=
ADMIN_PASSWORD=

CORS_ORIGIN=http://localhost:5173

# Storage paths (default to ./data/* inside this package if unset)
DB_PATH=
STORAGE_DIR=
BACKUPS_DIR=

RECONCILE_INTERVAL_MS=60000
NODE_HEARTBEAT_TIMEOUT_MS=45000
QUEUE_CONCURRENCY=5
MAX_UPLOAD_MB=100
LOG_LEVEL=info
