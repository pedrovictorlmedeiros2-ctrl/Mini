# Copy to .env in this directory. Get NODE_ID and NODE_TOKEN by registering
# this node from the admin panel (or POST /api/admin/nodes) — the token is
# shown exactly once at registration time.

NODE_ID=
NODE_TOKEN=
CONTROL_PLANE_WS_URL=ws://localhost:4000

VOLUMES_ROOT=
BACKUPS_ROOT=
HEARTBEAT_INTERVAL_MS=10000
CONTAINER_USER=1000:1000
LOG_TAIL_LINES=500
