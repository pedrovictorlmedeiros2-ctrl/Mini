# ============================================================
# HOSTING BOT v8.5 — ARQUIVO .env
# Preencha os campos marcados com >>> OBRIGATÓRIO <<<
# Depois: npm install && node index.js
# ============================================================

# ────────────────────────────────────────────────────────────
# >>> OBRIGATÓRIO — Discord Developer Portal
# https://discord.com/developers/applications
# 1) Crie uma Application
# 2) Bot → Reset Token → copie o token
# 3) OAuth2 → Client ID
# 4) Ative Privileged Gateway Intents se precisar (Message Content)
# 5) Invite o bot no servidor com permissões de gerenciar canais/mensagens
# ────────────────────────────────────────────────────────────

# Token do bot do PAINEL (não é token dos bots hospedados)
BOT_TOKEN=

# Application ID (Client ID) — só números, 17–20 dígitos
CLIENT_ID=

# Seu Discord user ID (modo desenvolvedor no Discord → clique direito no seu nome → Copiar ID)
OWNER_ID=

# Servidor de testes (opcional). Se preencher, comandos slash registram só nele (mais rápido).
# Deixe vazio para registrar globalmente (pode levar até 1h).
GUILD_ID=


# ────────────────────────────────────────────────────────────
# >>> OBRIGATÓRIO — Criptografia
# Já geramos uma chave forte. NÃO troque depois de colocar bots em produção
# senão tokens/backups antigos ficam ilegíveis.
# ────────────────────────────────────────────────────────────
ENCRYPTION_KEY=71401f56e7869965e6a46370b0366c907db851add665abcdd1bb59cb03da4d79


# ────────────────────────────────────────────────────────────
# Limites (pode deixar assim no começo)
# ────────────────────────────────────────────────────────────
# Limites padrão por usuário (plano free)
MAX_BOTS_PER_USER=3
MAX_CPU_PER_BOT=30
MAX_RAM_PER_BOT=256

# ── PROTEÇÃO DO SEU PC / HOST ────────────────────────────────
# Teto absoluto por bot (mesmo se o plano for maior)
HOST_MAX_RAM_PER_BOT=512
HOST_MAX_CPU_PER_BOT=50
HOST_MAX_BOTS_PER_USER=8
# % máxima da RAM total do PC que TODOS os bots juntos podem usar
# PC com 8GB e 55% ≈ 4.4GB no máximo pros bots
HOST_MAX_RAM_PERCENT=55
# Disjuntor de emergencia: se a RAM REAL do sistema (nao a soma calculada)
# passar disso, mata na hora o bot que mais consome, sem esperar o proximo ciclo
HOST_EMERGENCY_RAM_PERCENT=90
MAX_FILE_SIZE_MB=50
# Protecao contra zip bomb: limite do CONTEUDO descompactado (nao do .zip em si)
MAX_UNZIPPED_SIZE_MB=300
MAX_ZIP_ENTRIES=2000
# true = permite pip compilar pacote Python sem wheel pronto (roda codigo de
# terceiros no build). Deixe false a menos que precise mesmo de um pacote assim.
PYTHON_ALLOW_SDIST_BUILD=false


# ────────────────────────────────────────────────────────────
# Portas dos serviços internos
# ────────────────────────────────────────────────────────────
HEALTH_PORT=3001
HEALTH_HOST=0.0.0.0
WEBHOOK_PORT=3000
PROXY_PORT=80


# ────────────────────────────────────────────────────────────
# Notificações (opcional)
# ────────────────────────────────────────────────────────────
LOG_WEBHOOK_URL=
GITHUB_WEBHOOK_SECRET=cb21f0d5ba0566905262f4b8e1932f72

# Diagnóstico por IA (opcional) — https://console.groq.com
# Mesma chave usada em DOIS recursos independentes, ambos opcionais:
#  1) diagnosticManager.js — diagnóstico de logs sob demanda (comando do bot).
#  2) SecurityMonitor (Kamikaze Fase 2) — analisador AUXILIAR de segurança,
#     ver bloco "KAMIKAZE MODE" logo abaixo. Sem esta chave, o SecurityMonitor
#     roda mas NUNCA tenta rede — o Kamikaze determinístico (SecurityEngine/
#     IncidentResponseManager) continua funcionando de forma IDÊNTICA com ou
#     sem ela, já que o Groq nunca decide nada sozinho (só sugere, e só sinais
#     determinísticos ou correlação de evidência dura ativam CRITICAL).
GROQ_API_KEY=


# ────────────────────────────────────────────────────────────
# Canais de status dinâmicos (opcional — IDs de canais de voz/texto)
# ────────────────────────────────────────────────────────────
STATUS_CHANNEL_MEMBERS=
STATUS_CHANNEL_PING=
STATUS_CHANNEL_BOTS=
STATUS_CHANNEL_UPTIME=


# ────────────────────────────────────────────────────────────
# Isolamento por container (deixe false até ter Docker configurado)
# ────────────────────────────────────────────────────────────
USE_CONTAINERS=false
CONTAINER_IMAGE_NODE=hosting-bot-node:22
CONTAINER_IMAGE_PYTHON=hosting-bot-python:3.12
CONTAINER_NETWORK=bridge


# ────────────────────────────────────────────────────────────
# Multi-node / Failover (deixe false em instalação single-node)
# ────────────────────────────────────────────────────────────
FAILOVER_ENABLED=false
# FAILOVER_INTERVAL_MS=45000
# NODE_ROLE=worker
# NODE_ID=node-2
# NODE_NAME=Worker-1
# NODE_IP=10.0.0.2
# NODE_SECRET=
# WORKER_PORT=3002
# MASTER_URL=http://127.0.0.1:3001


# ────────────────────────────────────────────────────────────
# KAMIKAZE MODE — resposta automática a incidentes de segurança (opcional,
# habilitado por padrão). Nenhuma destas variáveis é obrigatória — os
# defaults já são seguros pra produção.
# ────────────────────────────────────────────────────────────
# KAMIKAZE_ENABLED=true
# Janela de correlação: sinais HIGH do mesmo bot dentro deste intervalo
# podem se combinar pra escalar a CRITICAL (ver SecurityEngine.js).
# KAMIKAZE_CORRELATION_WINDOW_MS=120000
# Quantas ocorrências do MESMO tipo de sinal, dentro da janela, fazem um
# SUSPICIOUS virar HIGH.
# KAMIKAZE_HIGH_THRESHOLD_COUNT=3
# Retenção da cópia em quarentena (dias) — só relevante pra uma purga
# manual/futura, nunca apagada automaticamente por este número sozinho.
# KAMIKAZE_QUARANTINE_RETENTION_DAYS=30

# ── SecurityMonitor + Groq (Fase 2) — analisador AUXILIAR, NUNCA decide
# nada sozinho. Sem GROQ_API_KEY (acima), roda mas nunca tenta rede. Se o
# Groq ficar indisponível/lento/der erro, o Kamikaze determinístico acima
# continua idêntico — isto só existe pra enriquecer observação, nunca pra
# substituir uma regra determinística. ──
# GROQ_MONITOR_ENABLED=true
# A cada quanto tempo o SecurityMonitor lê o audit_log em busca de sinais novos.
# GROQ_MONITOR_POLL_INTERVAL_MS=30000
# Timeout por chamada individual ao Groq.
# GROQ_MONITOR_TIMEOUT_MS=5000
# Tentativas ADICIONAIS além da primeira (1 = 2 tentativas no total), só
# pra erros que parecem transitórios (timeout, 5xx, 429, JSON inválido).
# GROQ_MONITOR_MAX_RETRIES=1
# Rate limit PRÓPRIO por minuto — nunca depende só do rate limit do Groq.
# GROQ_MONITOR_RATE_LIMIT_PER_MIN=20
# Circuit breaker: falhas consecutivas que abrem o circuito (para de tentar
# por um tempo, sem martelar uma API fora do ar) e o cooldown até a próxima
# tentativa de teste.
# GROQ_MONITOR_CIRCUIT_THRESHOLD=5
# GROQ_MONITOR_CIRCUIT_COOLDOWN_MS=120000
# Confiança mínima (0.0–1.0) da resposta do Groq pra sequer virar um sinal
# SUSPICIOUS/HIGH no SecurityEngine — abaixo disso, só fica registrado no
# audit_log, sem nenhuma ação.
# GROQ_MONITOR_MIN_CONFIDENCE=0.6
# Quantas chamadas operacionais seguidas (Groq habilitado E com chave
# configurada) precisam falhar antes do health check (/health, serviceReadiness.js)
# reportar DEGRADED por indisponibilidade prolongada do Groq — NUNCA vira
# BLOCKED, hospedagem continua normal com ou sem o Groq no ar.
# GROQ_MONITOR_DEGRADED_AFTER_FAILURES=5


# ────────────────────────────────────────────────────────────
# Backup offsite S3/R2 (opcional)
# ────────────────────────────────────────────────────────────
OFFSITE_BACKUP_ENABLED=false
# S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
# S3_BUCKET=hosting-backups
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto


# ────────────────────────────────────────────────────────────
# Ambiente
# ────────────────────────────────────────────────────────────
NODE_ENV=production
# Com NODE_ENV=production, o serviço exige isolamento Linux forte (bwrap +
# cgroup v2 delegado + nftables) pra hospedar bots — se não estiver
# disponível, o estado global vira BLOCKED (ver src/managers/serviceReadiness.js):
# nenhum bot inicia, nenhum provisionamento roda, NUNCA cai silenciosamente
# pro backend reduzido. Só o bot de controle do Discord continua respondendo.
# REQUIRE_LINUX_SANDBOX (true|false), se definido, tem prioridade sobre
# NODE_ENV pra essa decisão específica — use com cuidado.
# REQUIRE_LINUX_SANDBOX=true
